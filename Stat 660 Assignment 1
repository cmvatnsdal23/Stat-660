    {name:"Israel",     score:7.234},
    {name:"Luxembourg", score:7.122},
    {name:"Mexico",     score:6.979}
  ];
  const minScore = 6.5, maxScore = 8.0, chartH = 220;
  const bc = document.getElementById('barChart');
  countries.forEach(c => {
    const pct = (c.score - minScore) / (maxScore - minScore);
    const h   = Math.round(pct * chartH);
    const t   = (c.score - 6.979) / (7.736 - 6.979);
    const r   = Math.round(247 - t*(247-26));
    const g   = Math.round(220 - t*(220-152));
    const b   = Math.round(111 - t*(111-80));
    const col = `rgb(${r},${g},${b})`;
    bc.innerHTML += `<div class="bar-wrap">
      <span class="bar-val">${c.score}</span>
      <div class="bar" style="height:${h}px;background:${col};"></div>
      <span class="bar-label">${c.name}</span>
    </div>`;
  });

  // ── HEATMAP (Q3) ──
