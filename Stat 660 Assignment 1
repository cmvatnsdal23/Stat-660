<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Happiness Levels Across Countries – Cole Vatnsdal</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --cream: #faf8f3;
      --ink: #1a1a2e;
      --muted: #5a5a72;
      --accent: #2d6a4f;
      --accent-light: #74c69d;
      --rule: #d4cfc4;
      --code-bg: #f0ede6;
      --warn: #e8d5b0;
      --warn-border: #c9a84c;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--cream);
      color: var(--ink);
      font-family: 'Source Serif 4', Georgia, serif;
      font-weight: 300;
      line-height: 1.8;
      font-size: 17px;
    }

    /* ── HEADER ── */
    header {
      background: var(--ink);
      color: var(--cream);
      padding: 64px 40px 48px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 40px,
        rgba(255,255,255,0.02) 40px,
        rgba(255,255,255,0.02) 41px
      );
    }
    header .tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      color: var(--accent-light);
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    header h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 5vw, 3.6rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.02em;
      position: relative;
    }
    header .byline {
      margin-top: 20px;
      font-size: 14px;
      color: rgba(250,248,243,0.55);
      letter-spacing: 0.05em;
    }
    header .byline strong { color: rgba(250,248,243,0.85); }

    /* ── NAV ── */
    nav {
      background: white;
      border-bottom: 1px solid var(--rule);
      padding: 0 40px;
      display: flex;
      gap: 0;
      overflow-x: auto;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    nav a {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--muted);
      padding: 16px 18px;
      border-bottom: 2px solid transparent;
      transition: all 0.2s;
      white-space: nowrap;
    }
    nav a:hover { color: var(--accent); border-bottom-color: var(--accent); }

    /* ── MAIN ── */
    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 32px 80px;
    }

    /* ── SECTIONS ── */
    section {
      padding-top: 64px;
      border-top: 1px solid var(--rule);
      margin-top: 64px;
    }
    section:first-of-type { border-top: none; }

    .section-number {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    h2 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 28px;
      color: var(--ink);
    }
    h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      margin: 32px 0 12px;
      color: var(--ink);
    }
    p { margin-bottom: 16px; color: var(--ink); }

    /* ── CODE BLOCKS ── */
    .code-block {
      background: var(--code-bg);
      border-left: 3px solid var(--accent);
      border-radius: 0 6px 6px 0;
      padding: 20px 24px;
      margin: 24px 0;
      overflow-x: auto;
    }
    .code-block pre {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12.5px;
      line-height: 1.7;
      color: #2c2c3e;
      white-space: pre;
    }
    .code-block .comment { color: #6b7a8d; font-style: italic; }
    .code-block .kw { color: #2d6a4f; font-weight: 500; }
    .code-block .str { color: #8b4513; }
    .code-block .fn { color: #1a4a8a; }

    /* ── OUTPUT / WARNING BLOCKS ── */
    .output-block {
      background: white;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 16px 20px;
      margin: 16px 0;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      line-height: 1.7;
      color: var(--muted);
      overflow-x: auto;
    }
    .output-block .label {
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .warning-block {
      background: var(--warn);
      border-left: 3px solid var(--warn-border);
      border-radius: 0 6px 6px 0;
      padding: 12px 18px;
      margin: 12px 0;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      color: #5a4010;
      line-height: 1.6;
    }

    /* ── PLOT PLACEHOLDERS ── */
    .plot-frame {
      background: white;
      border: 1px solid var(--rule);
      border-radius: 8px;
      overflow: hidden;
      margin: 28px 0;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .plot-frame .plot-title-bar {
      background: var(--ink);
      color: var(--cream);
      padding: 10px 18px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .plot-frame .plot-title-bar .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--accent-light);
    }
    .plot-frame .plot-body {
      padding: 32px 24px;
    }

    /* ── CHART IMPLEMENTATIONS ── */

    /* Bar chart – Q1 */
    .bar-chart { width: 100%; }
    .bar-chart .chart-title {
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: 1.05rem;
      margin-bottom: 4px;
    }
    .bar-chart .chart-subtitle {
      text-align: center;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 24px;
    }
    .bar-chart .bars-area {
      display: flex;
      align-items: flex-end;
      gap: 6px;
      height: 220px;
      padding-bottom: 0;
      border-bottom: 2px solid var(--rule);
      border-left: 2px solid var(--rule);
      padding-left: 8px;
      position: relative;
    }
    .bar-chart .y-label {
      position: absolute;
      left: -52px;
      top: 50%;
      transform: rotate(-90deg) translateX(50%);
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }
    .bar-wrap { display: flex; flex-direction: column; align-items: center; flex: 1; }
    .bar-wrap .bar-val {
      font-size: 9.5px;
      font-weight: 600;
      margin-bottom: 3px;
      color: var(--ink);
    }
    .bar-wrap .bar {
      width: 100%;
      border-radius: 3px 3px 0 0;
      position: relative;
      transition: opacity 0.2s;
    }
    .bar-wrap .bar:hover { opacity: 0.85; }
    .bar-wrap .bar-label {
      font-size: 9px;
      text-align: center;
      color: var(--muted);
      margin-top: 6px;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      height: 70px;
      line-height: 1;
    }
    .chart-axis-x {
      text-align: center;
      font-size: 12px;
      color: var(--muted);
      margin-top: 8px;
    }

    /* Line chart – Q2 */
    .line-chart-wrap { position: relative; }
    .line-chart-wrap svg { width: 100%; height: auto; }

    /* Heatmap – Q3 */
    .heatmap { overflow-x: auto; }
    .heatmap table { border-collapse: collapse; min-width: 500px; width: 100%; }
    .heatmap th {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--muted);
      padding: 4px 8px;
      font-weight: 400;
    }
    .heatmap td {
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      border: 2px solid white;
      border-radius: 3px;
    }
    .heatmap .country-label {
      font-size: 12px;
      color: var(--ink);
      padding-right: 12px;
      text-align: right;
      background: transparent !important;
      border: none !important;
    }
    .cell-yes { background: #2ecc71; color: white; }
    .cell-no  { background: #e8e6e1; color: transparent; }

    /* Scatter facet – Q4 */
    .scatter-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .scatter-panel {
      background: white;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 16px;
    }
    .scatter-panel .panel-year {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      text-align: center;
      margin-bottom: 8px;
      color: var(--ink);
    }
    .scatter-panel svg { width: 100%; height: auto; }

    /* Boxplot – Q5 */
    .boxplot-wrap svg { width: 100%; height: auto; }

    /* Bubble – Q6 */
    .bubble-wrap svg { width: 100%; height: auto; }

    /* Treemap – Q7 */
    .treemap-grid {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      grid-template-rows: repeat(5, 44px);
      gap: 2px;
      font-size: 9px;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }
    .tm-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      line-height: 1.2;
      padding: 2px;
      border-radius: 2px;
      color: var(--ink);
      font-size: 8.5px;
    }

    /* Choropleth – Q8 */
    .choropleth-wrap svg { width: 100%; height: auto; }

    /* ── ANALYSIS ── */
    .analysis-box {
      background: white;
      border: 1px solid var(--rule);
      border-left: 4px solid var(--accent);
      border-radius: 0 8px 8px 0;
      padding: 28px 32px;
      margin-top: 32px;
    }
    .analysis-box .analysis-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 16px;
    }
    .analysis-box p { margin-bottom: 14px; }
    .analysis-box p:last-child { margin-bottom: 0; }

    /* ── TABLE ── */
    .data-table { width: 100%; border-collapse: collapse; margin: 16px 0; }
    .data-table th {
      background: var(--ink);
      color: var(--cream);
      padding: 10px 16px;
      text-align: left;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      font-weight: 400;
    }
    .data-table td {
      padding: 8px 16px;
      border-bottom: 1px solid var(--rule);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--muted);
    }
    .data-table tr:nth-child(even) td { background: #f5f3ee; }

    /* ── FOOTER ── */
    footer {
      background: var(--ink);
      color: rgba(250,248,243,0.45);
      text-align: center;
      padding: 32px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
    }
    footer a { color: var(--accent-light); text-decoration: none; }

    @media (max-width: 640px) {
      main { padding: 0 16px 60px; }
      header { padding: 40px 20px 32px; }
      nav { padding: 0 16px; }
      .scatter-grid { grid-template-columns: 1fr; }
      .treemap-grid { grid-template-columns: repeat(5, 1fr); grid-template-rows: repeat(10, 40px); }
    }
  </style>
</head>
<body>

<header>
  <div class="tag">Stat 660 &nbsp;·&nbsp; Project 1 &nbsp;·&nbsp; World Happiness Report</div>
  <h1>Happiness Levels Across Countries</h1>
  <p class="byline">By <strong>Cole Vatnsdal</strong> &nbsp;·&nbsp; Data: Wikipedia World Happiness Report (2017–2020)</p>
</header>

<nav>
  <a href="#q1">Top 10</a>
  <a href="#q2">Trends</a>
  <a href="#q3">Rankings</a>
  <a href="#q4">GDP</a>
  <a href="#q5">Regions</a>
  <a href="#q6">Bubble</a>
  <a href="#q7">Treemap</a>
  <a href="#q8">Map</a>
  <a href="#analysis">Analysis</a>
</nav>

<main>

  <!-- ── SETUP ── -->
  <section id="setup">
    <div class="section-number">Setup</div>
    <h2>Packages &amp; Data Loading</h2>
    <div class="code-block"><pre><span class="kw">packages</span> &lt;- c(<span class="str">"ggplot2"</span>, <span class="str">"dplyr"</span>, <span class="str">"tidyr"</span>, <span class="str">"maps"</span>, <span class="str">"treemap"</span>, <span class="str">"sqldf"</span>,
              <span class="str">"ggrepel"</span>, <span class="str">"RColorBrewer"</span>, <span class="str">"viridis"</span>, <span class="str">"rvest"</span>, <span class="str">"stringr"</span>)
<span class="fn">install.packages</span>(packages[!packages %in% <span class="fn">installed.packages</span>()[,<span class="str">"Package"</span>]])

<span class="fn">library</span>(ggplot2);  <span class="fn">library</span>(dplyr);    <span class="fn">library</span>(tidyr)
<span class="fn">library</span>(maps);     <span class="fn">library</span>(treemap);  <span class="fn">library</span>(sqldf)
<span class="fn">library</span>(ggrepel);  <span class="fn">library</span>(RColorBrewer); <span class="fn">library</span>(viridis)
<span class="fn">library</span>(rvest);    <span class="fn">library</span>(stringr)</pre></div>

    <div class="code-block"><pre>url       &lt;- <span class="str">"https://en.wikipedia.org/wiki/World_Happiness_Report"</span>
page      &lt;- <span class="fn">read_html</span>(url)
all_tables &lt;- page %&gt;% <span class="fn">html_nodes</span>(<span class="str">"table.wikitable"</span>) %&gt;% <span class="fn">html_table</span>(fill = TRUE)

happiness_most_recent &lt;- <span class="fn">clean_table</span>(all_tables[[1]], 2024)
happiness_2020        &lt;- <span class="fn">clean_table</span>(all_tables[[5]], 2020)
happiness_2019        &lt;- <span class="fn">clean_table</span>(all_tables[[6]], 2019)
happiness_2018        &lt;- <span class="fn">clean_table</span>(all_tables[[7]], 2018)
happiness_2017        &lt;- <span class="fn">clean_table_2017</span>(all_tables[[8]], 2017)

happiness_all &lt;- <span class="fn">bind_rows</span>(happiness_2017, happiness_2018, happiness_2019, happiness_2020) %&gt;%
  <span class="fn">filter</span>(!<span class="fn">is.na</span>(Score)) %&gt;%
  <span class="fn">mutate</span>(Country = <span class="fn">recode</span>(Country, <span class="str">"United States of America"</span> = <span class="str">"United States"</span>))</pre></div>
  </section>

  <!-- ── Q1 ── -->
  <section id="q1">
    <div class="section-number">Question 1</div>
    <h2>Top 10 Happiest Countries (Most Recent Year)</h2>

    <div class="code-block"><pre>top10_recent &lt;- happiness_most_recent %&gt;%
  <span class="fn">arrange</span>(<span class="fn">desc</span>(Score)) %&gt;% <span class="fn">head</span>(10) %&gt;%
  <span class="fn">mutate</span>(Country = <span class="fn">factor</span>(Country, levels = Country[<span class="fn">order</span>(Score, decreasing = TRUE)]))

<span class="fn">ggplot</span>(top10_recent, <span class="fn">aes</span>(x = Country, y = Score, fill = Score)) +
  <span class="fn">geom_bar</span>(stat = <span class="str">"identity"</span>, color = <span class="str">"black"</span>, width = 0.7) +
  <span class="fn">geom_text</span>(<span class="fn">aes</span>(label = <span class="fn">round</span>(Score, 3)), vjust = -0.5, size = 3.5, fontface = <span class="str">"bold"</span>) +
  <span class="fn">scale_fill_gradient</span>(low = <span class="str">"#f7dc6f"</span>, high = <span class="str">"#1a9850"</span>) +
  <span class="fn">coord_cartesian</span>(ylim = c(6.5, 8))</pre></div>

    <div class="plot-frame">
      <div class="plot-title-bar"><span class="dot"></span> Figure 1 — Top 10 Happiest Countries (Most Recent Year)</div>
      <div class="plot-body">
        <div class="bar-chart">
          <div class="chart-title">Top 10 Happiest Countries (Most Recent Year)</div>
          <div class="chart-subtitle">World Happiness Report</div>
          <div style="position:relative; padding-left:56px;">
            <span style="position:absolute;left:0;top:50%;transform:rotate(-90deg) translateX(50%);font-size:12px;color:#5a5a72;white-space:nowrap;">Happiness Score</span>
            <div class="bars-area" id="barChart"></div>
          </div>
          <div class="chart-axis-x" style="margin-left:56px;">Country</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Q2 ── -->
  <section id="q2">
    <div class="section-number">Question 2</div>
    <h2>Happiness Score Trends (2017–2020)</h2>
    <p>Tracking six major countries: China, India, USA, Indonesia, Japan, and Russia.</p>

    <div class="code-block"><pre><span class="fn">ggplot</span>(trend_data, <span class="fn">aes</span>(x = Year, y = Score, color = Country, group = Country)) +
  <span class="fn">geom_line</span>(linewidth = 1.3) +
  <span class="fn">geom_point</span>(size = 3.5, shape = 21, fill = <span class="str">"white"</span>, stroke = 1.5) +
  <span class="fn">geom_text_repel</span>(data = trend_data %&gt;% <span class="fn">filter</span>(Year == <span class="fn">max</span>(Year)),
                  <span class="fn">aes</span>(label = <span class="fn">round</span>(Score, 2)), nudge_x = 0.2) +
  <span class="fn">scale_x_continuous</span>(breaks = c(2017, 2018, 2019, 2020)) +
  <span class="fn">scale_color_brewer</span>(palette = <span class="str">"Set1"</span>)</pre></div>

    <div class="plot-frame">
      <div class="plot-title-bar"><span class="dot"></span> Figure 2 — Happiness Score Trends (2017–2020)</div>
      <div class="plot-body">
        <svg viewBox="0 0 700 380" xmlns="http://www.w3.org/2000/svg" font-family="'Source Serif 4', serif">
          <!-- title -->
          <text x="350" y="28" text-anchor="middle" font-size="16" font-weight="700" font-family="'Playfair Display',serif">Happiness Score Trends (2017-2020)</text>
          <text x="350" y="46" text-anchor="middle" font-size="12" fill="#5a5a72">China, India, USA, Indonesia, Japan, Russia</text>
          <!-- axes -->
          <line x1="70" y1="60" x2="70" y2="320" stroke="#d4cfc4" stroke-width="1.5"/>
          <line x1="70" y1="320" x2="600" y2="320" stroke="#d4cfc4" stroke-width="1.5"/>
          <!-- y-axis labels -->
          <text x="62" y="64"  text-anchor="end" font-size="11" fill="#5a5a72">7</text>
          <text x="62" y="134" text-anchor="end" font-size="11" fill="#5a5a72">6</text>
          <text x="62" y="204" text-anchor="end" font-size="11" fill="#5a5a72">5</text>
          <text x="62" y="274" text-anchor="end" font-size="11" fill="#5a5a72">4</text>
          <!-- grid lines -->
          <line x1="70" y1="64"  x2="600" y2="64"  stroke="#e8e6e1" stroke-width="1"/>
          <line x1="70" y1="134" x2="600" y2="134" stroke="#e8e6e1" stroke-width="1"/>
          <line x1="70" y1="204" x2="600" y2="204" stroke="#e8e6e1" stroke-width="1"/>
          <line x1="70" y1="274" x2="600" y2="274" stroke="#e8e6e1" stroke-width="1"/>
          <!-- x-axis labels -->
          <text x="130" y="338" text-anchor="middle" font-size="11" fill="#5a5a72">2017</text>
          <text x="290" y="338" text-anchor="middle" font-size="11" fill="#5a5a72">2018</text>
          <text x="450" y="338" text-anchor="middle" font-size="11" fill="#5a5a72">2019</text>
          <text x="570" y="338" text-anchor="middle" font-size="11" fill="#5a5a72">2020</text>
          <text x="350" y="360" text-anchor="middle" font-size="12" fill="#5a5a72">Year</text>
          <text x="22" y="195" text-anchor="middle" font-size="12" fill="#5a5a72" transform="rotate(-90,22,195)">Happiness Score</text>

          <!-- USA: ~7.0, 6.89, 6.94, 6.94 -->
          <polyline points="130,64 290,75 450,68 570,68" fill="none" stroke="#f0c040" stroke-width="2.2"/>
          <circle cx="130" cy="64"  r="5" fill="white" stroke="#f0c040" stroke-width="2"/>
          <circle cx="290" cy="75"  r="5" fill="white" stroke="#f0c040" stroke-width="2"/>
          <circle cx="450" cy="68"  r="5" fill="white" stroke="#f0c040" stroke-width="2"/>
          <circle cx="570" cy="68"  r="5" fill="white" stroke="#f0c040" stroke-width="2"/>
          <text x="582" y="72"  font-size="10" fill="#f0c040">6.94</text>

          <!-- Japan: ~5.92, 5.89, 5.89, 5.87 -->
          <polyline points="130,142 290,145 450,145 570,147" fill="none" stroke="#9b59b6" stroke-width="2.2"/>
          <circle cx="130" cy="142" r="5" fill="white" stroke="#9b59b6" stroke-width="2"/>
          <circle cx="290" cy="145" r="5" fill="white" stroke="#9b59b6" stroke-width="2"/>
          <circle cx="450" cy="145" r="5" fill="white" stroke="#9b59b6" stroke-width="2"/>
          <circle cx="570" cy="147" r="5" fill="white" stroke="#9b59b6" stroke-width="2"/>
          <text x="582" y="151" font-size="10" fill="#9b59b6">5.87</text>

